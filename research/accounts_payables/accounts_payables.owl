# ============================================================================
# Constraints and Axioms
# ============================================================================

# Disjointness Axioms
[] a owl:AllDisjointClasses ;
    owl:members (
        ap:VendorAccount
        ap:PurchaseInvoice
        ap:VendorPaymentCheck
        ap:TaxForm1099Report
    ) .

[] a owl:AllDisjointClasses ;
    owl:members (
        agent:InvoiceProcessingAgent
        agent:PaymentProcessingAgent
        agent:VendorManagementAgent
        agent:TaxComplianceAgent
        agent:ReconciliationAgent
    ) .

# Cardinality Constraints
ap:PurchaseInvoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ap:fromVendor ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

ap:VendorPaymentCheck rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ap:paidToVendor ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

ap:CheckInvoiceApplication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ap:appliesPaymentCheck ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ap:appliesToInvoice ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .

# Functional Property Chains
ap:paysForInvoice a owl:ObjectProperty ;
    rdfs:label "pays for invoice"@en ;
    owl:propertyChainAxiom (ap:hasCheckApplication ap:appliesToInvoice) ;
    rdfs:comment "Transitive payment relationship through applications"@en .

# ============================================================================
# SWRL Rules (for reasoning capabilities)
# ============================================================================

# Rule: Mark invoice as paid when balance reaches zero
# PurchaseInvoice(?inv) ∧ hasOutstandingBalanceAmount(?inv, 0) 
# → hasInvoicePaymentStatus(?inv, Paid)

# Rule: Suspend vendor if multiple overdue invoices
# VendorAccount(?vendor) ∧ issuesInvoice(?vendor, ?inv1) ∧ issuesInvoice(?vendor, ?inv2) 
# ∧ differentFrom(?inv1, ?inv2) ∧ hasInvoicePaymentStatus(?inv1, Unpaid) 
# ∧ hasInvoicePaymentStatus(?inv2, Unpaid) ∧ isOverdue(?inv1, true) ∧ isOverdue(?inv2, true)
# → hasVendorAccountStatus(?vendor, Suspended)

# Rule: Generate recurring invoice on due date
# RecurringInvoiceTemplate(?template) ∧ hasNextGenerationDate(?template, ?date) 
# ∧ temporal:hasDateTimeDescription(?today, ?date) 
# → generates(?template, ?newInvoice)

# ============================================================================
# Annotations
# ============================================================================

ap:VendorAccount rdfs:seeAlso <https://www.irs.gov/forms-pubs/about-form-1099-misc> ;
    rdfs:isDefinedBy <http://accountex.org/ontology/accounts-payables> .

ap:PurchaseInvoice rdfs:seeAlso <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Invoice> ;
    rdfs:isDefinedBy <http://accountex.org/ontology/accounts-payables> .

agent:AccountsPayablesAgent rdfs:seeAlso <https://hexdocs.pm/jido/> ;
    rdfs:isDefinedBy <http://accountex.org/ontology/agent> .

event:AccountsPayablesEvent rdfs:seeAlso <https://hexdocs.pm/commanded/> ;
    rdfs:isDefinedBy <http://accountex.org/ontology/event> .
