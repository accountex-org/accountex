@prefix : <http://accountex.org/ontologies/system-manager#> .
@prefix sm: <http://accountex.org/ontologies/system-manager#> .
@prefix jido: <http://accountex.org/ontologies/jido#> .
@prefix commanded: <http://accountex.org/ontologies/commanded#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontology Declaration with Imports
<http://accountex.org/ontologies/system-manager> a owl:Ontology ;
    owl:imports <http://accountex.org/ontologies/jido> ;
    owl:imports <http://accountex.org/ontologies/commanded> ;
    rdfs:label "System Manager Ontology" ;
    rdfs:comment "Ontology for managing the core Elixir Application that orchestrates pluggable applications using Jido agents and Commanded event sourcing" ;
    owl:versionInfo "2.0.0" ;
    owl:versionIRI <http://accountex.org/ontologies/system-manager/2.0.0> .

# ============================================
# System Manager Core Classes
# ============================================

sm:SystemApplication a owl:Class ;
    rdfs:label "System Application" ;
    rdfs:comment "An Elixir Application that can be plugged into the core system at runtime" ;
    rdfs:subClassOf jido:Agent .

sm:CoreApplication a owl:Class ;
    rdfs:label "Core Application" ;
    rdfs:comment "The central Elixir Application that orchestrates all pluggable applications" ;
    rdfs:subClassOf sm:SystemApplication .

sm:PluggableModule a owl:Class ;
    rdfs:label "Pluggable Module" ;
    rdfs:comment "A module that can be dynamically loaded and unloaded at runtime" ;
    rdfs:subClassOf jido:Skill .

sm:SystemEvent a owl:Class ;
    rdfs:label "System Event" ;
    rdfs:comment "System-level events for application lifecycle and inter-application communication" ;
    rdfs:subClassOf commanded:Event .

sm:SystemCommand a owl:Class ;
    rdfs:label "System Command" ;
    rdfs:comment "Commands for managing system applications and their lifecycle" ;
    rdfs:subClassOf commanded:Command .

sm:ApplicationAggregate a owl:Class ;
    rdfs:label "Application Aggregate" ;
    rdfs:comment "Aggregate representing an application's state and lifecycle" ;
    rdfs:subClassOf commanded:Aggregate .

sm:SystemProcessManager a owl:Class ;
    rdfs:label "System Process Manager" ;
    rdfs:comment "Process manager for coordinating inter-application workflows" ;
    rdfs:subClassOf commanded:ProcessManager .

sm:ApplicationSensor a owl:Class ;
    rdfs:label "Application Sensor" ;
    rdfs:comment "Sensor monitoring application health and availability" ;
    rdfs:subClassOf jido:Sensor .

sm:InterApplicationSignal a owl:Class ;
    rdfs:label "Inter-Application Signal" ;
    rdfs:comment "CloudEvents-based signals for communication between applications" ;
    rdfs:subClassOf jido:Signal .

sm:ApplicationWorkflow a owl:Class ;
    rdfs:label "Application Workflow" ;
    rdfs:comment "Workflow orchestrating actions across multiple applications" ;
    rdfs:subClassOf jido:Workflow .

# ============================================
# System Manager Object Properties
# ============================================

sm:orchestrates a owl:ObjectProperty ;
    rdfs:label "orchestrates" ;
    rdfs:comment "The core application orchestrates pluggable applications" ;
    rdfs:domain sm:CoreApplication ;
    rdfs:range sm:SystemApplication .

sm:registersModule a owl:ObjectProperty ;
    rdfs:label "registers module" ;
    rdfs:comment "Application registers a pluggable module" ;
    rdfs:domain sm:SystemApplication ;
    rdfs:range sm:PluggableModule .

sm:monitorsApplication a owl:ObjectProperty ;
    rdfs:label "monitors application" ;
    rdfs:comment "Sensor monitors an application's health" ;
    rdfs:domain sm:ApplicationSensor ;
    rdfs:range sm:SystemApplication ;
    rdfs:subPropertyOf jido:monitors .

sm:communicatesWith a owl:ObjectProperty ;
    rdfs:label "communicates with" ;
    rdfs:comment "Applications communicate via signals" ;
    rdfs:domain sm:SystemApplication ;
    rdfs:range sm:SystemApplication .

sm:handlesSystemCommand a owl:ObjectProperty ;
    rdfs:label "handles system command" ;
    rdfs:comment "Application aggregate handles system commands" ;
    rdfs:domain sm:ApplicationAggregate ;
    rdfs:range sm:SystemCommand ;
    rdfs:subPropertyOf commanded:processesCommand .

sm:emitsSystemEvent a owl:ObjectProperty ;
    rdfs:label "emits system event" ;
    rdfs:comment "Application aggregate emits system events" ;
    rdfs:domain sm:ApplicationAggregate ;
    rdfs:range sm:SystemEvent ;
    rdfs:subPropertyOf commanded:emitsEvent .

sm:coordinatesApplications a owl:ObjectProperty ;
    rdfs:label "coordinates applications" ;
    rdfs:comment "Process manager coordinates multiple applications" ;
    rdfs:domain sm:SystemProcessManager ;
    rdfs:range sm:SystemApplication .

sm:executesInterApplicationWorkflow a owl:ObjectProperty ;
    rdfs:label "executes inter-application workflow" ;
    rdfs:comment "Core executes workflows spanning multiple applications" ;
    rdfs:domain sm:CoreApplication ;
    rdfs:range sm:ApplicationWorkflow ;
    rdfs:subPropertyOf jido:executesWorkflow .

# ============================================
# System Manager Data Properties
# ============================================

sm:applicationName a owl:DatatypeProperty ;
    rdfs:label "application name" ;
    rdfs:comment "The name of the Elixir application" ;
    rdfs:domain sm:SystemApplication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf jido:hasName .

sm:applicationStatus a owl:DatatypeProperty ;
    rdfs:label "application status" ;
    rdfs:comment "Current status of the application (available, unavailable, loading)" ;
    rdfs:domain sm:SystemApplication ;
    rdfs:range xsd:string .

sm:isAvailable a owl:DatatypeProperty ;
    rdfs:label "is available" ;
    rdfs:comment "Whether the application is currently available at runtime" ;
    rdfs:domain sm:SystemApplication ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf jido:isRunning .

sm:loadPriority a owl:DatatypeProperty ;
    rdfs:label "load priority" ;
    rdfs:comment "Priority order for loading applications" ;
    rdfs:domain sm:SystemApplication ;
    rdfs:range xsd:integer .

sm:configurationPath a owl:DatatypeProperty ;
    rdfs:label "configuration path" ;
    rdfs:comment "Path to the application's configuration" ;
    rdfs:domain sm:SystemApplication ;
    rdfs:range xsd:string .

sm:healthCheckInterval a owl:DatatypeProperty ;
    rdfs:label "health check interval" ;
    rdfs:comment "Interval for health monitoring in milliseconds" ;
    rdfs:domain sm:ApplicationSensor ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf jido:hasEmitInterval .

# ============================================
# Alignment Axioms
# ============================================

# System Applications are specialized Jido Agents
sm:SystemApplication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty jido:hasSkill ;
    owl:someValuesFrom sm:PluggableModule
] .

# System Applications must have at least one aggregate
sm:SystemApplication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty commanded:hasStream ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Core Application must orchestrate at least one application
sm:CoreApplication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty sm:orchestrates ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Application Aggregates must handle system commands
sm:ApplicationAggregate rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty sm:handlesSystemCommand ;
    owl:someValuesFrom sm:SystemCommand
] .

# System Process Managers listen to system events
sm:SystemProcessManager rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty commanded:listensToEvent ;
    owl:someValuesFrom sm:SystemEvent
] .
