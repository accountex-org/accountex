<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:commanded="http://accountex.org/ontologies/commanded#"
         xml:base="http://accountex.org/ontologies/commanded">

  <owl:Ontology rdf:about="http://accountex.org/ontologies/commanded">
    <rdfs:label>Commanded Framework Ontology</rdfs:label>
    <rdfs:comment>An ontology describing the Commanded CQRS/Event Sourcing framework for Elixir, including commands, events, aggregates, process managers, projections, event stores, and their relationships for building event-driven applications.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="http://accountex.org/ontologies/commanded/1.0.0"/>
  </owl:Ontology>

  <!-- Core Classes -->

  <owl:Class rdf:about="#Command">
    <rdfs:label>Command</rdfs:label>
    <rdfs:comment>A request to change system state that is dispatched to an aggregate. Commands represent user intentions and business operations that should be performed.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Event">
    <rdfs:label>Event</rdfs:label>
    <rdfs:comment>A record of a change that occurred in the system. Events are immutable facts that are stored in the event store and used to rebuild aggregate state and update projections.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Aggregate">
    <rdfs:label>Aggregate</rdfs:label>
    <rdfs:comment>A consistency boundary that encapsulates business logic and maintains state derived from events. Aggregates process commands and emit events while enforcing business rules and invariants.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#ProcessManager">
    <rdfs:label>Process Manager</rdfs:label>
    <rdfs:comment>A long-running business process that coordinates workflows across multiple aggregates by listening to events and dispatching commands to orchestrate complex business scenarios.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Projection">
    <rdfs:label>Projection</rdfs:label>
    <rdfs:comment>A read model that builds denormalized views from events for querying. Projections transform event streams into formats optimized for specific query patterns.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#EventStore">
    <rdfs:label>Event Store</rdfs:label>
    <rdfs:comment>The persistent storage system for events that provides append-only storage, event streaming capabilities, and supports event replay for rebuilding system state.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#EventStream">
    <rdfs:label>Event Stream</rdfs:label>
    <rdfs:comment>An ordered sequence of events for a specific aggregate instance, maintaining the history of all state changes for that aggregate.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#CommandHandler">
    <rdfs:label>Command Handler</rdfs:label>
    <rdfs:comment>The component responsible for routing commands to appropriate aggregates and managing the command execution lifecycle.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#EventHandler">
    <rdfs:label>Event Handler</rdfs:label>
    <rdfs:comment>A component that processes events to perform side effects, update read models, or trigger additional business processes.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Snapshot">
    <rdfs:label>Snapshot</rdfs:label>
    <rdfs:comment>A point-in-time representation of aggregate state used for performance optimization, avoiding the need to replay all events when rebuilding aggregate state.</rdfs:comment>
  </owl:Class>

  <!-- Object Properties -->

  <owl:ObjectProperty rdf:about="#processesCommand">
    <rdfs:label>processes command</rdfs:label>
    <rdfs:comment>Associates an aggregate with commands it can process</rdfs:comment>
    <rdfs:domain rdf:resource="#Aggregate"/>
    <rdfs:range rdf:resource="#Command"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#emitsEvent">
    <rdfs:label>emits event</rdfs:label>
    <rdfs:comment>Associates an aggregate with events it can emit</rdfs:comment>
    <rdfs:domain rdf:resource="#Aggregate"/>
    <rdfs:range rdf:resource="#Event"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#appliesEvent">
    <rdfs:label>applies event</rdfs:label>
    <rdfs:comment>Associates an aggregate with events it applies to modify its state</rdfs:comment>
    <rdfs:domain rdf:resource="#Aggregate"/>
    <rdfs:range rdf:resource="#Event"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#handlesCommand">
    <rdfs:label>handles command</rdfs:label>
    <rdfs:comment>Associates a command handler with commands it processes</rdfs:comment>
    <rdfs:domain rdf:resource="#CommandHandler"/>
    <rdfs:range rdf:resource="#Command"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#handlesEvent">
    <rdfs:label>handles event</rdfs:label>
    <rdfs:comment>Associates an event handler with events it processes</rdfs:comment>
    <rdfs:domain rdf:resource="#EventHandler"/>
    <rdfs:range rdf:resource="#Event"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#dispatchesCommand">
    <rdfs:label>dispatches command</rdfs:label>
    <rdfs:comment>Associates a process manager with commands it dispatches</rdfs:comment>
    <rdfs:domain rdf:resource="#ProcessManager"/>
    <rdfs:range rdf:resource="#Command"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#listensToEvent">
    <rdfs:label>listens to event</rdfs:label>
    <rdfs:comment>Associates a process manager or projection with events it subscribes to</rdfs:comment>
    <rdfs:range rdf:resource="#Event"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#storesEvent">
    <rdfs:label>stores event</rdfs:label>
    <rdfs:comment>Associates an event store with events it persists</rdfs:comment>
    <rdfs:domain rdf:resource="#EventStore"/>
    <rdfs:range rdf:resource="#Event"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#belongsToStream">
    <rdfs:label>belongs to stream</rdfs:label>
    <rdfs:comment>Associates an event with the event stream it belongs to</rdfs:comment>
    <rdfs:domain rdf:resource="#Event"/>
    <rdfs:range rdf:resource="#EventStream"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasStream">
    <rdfs:label>has stream</rdfs:label>
    <rdfs:comment>Associates an aggregate with its event stream</rdfs:comment>
    <rdfs:domain rdf:resource="#Aggregate"/>
    <rdfs:range rdf:resource="#EventStream"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#buildsProjection">
    <rdfs:label>builds projection</rdfs:label>
    <rdfs:comment>Associates events with projections they help build</rdfs:comment>
    <rdfs:domain rdf:resource="#Event"/>
    <rdfs:range rdf:resource="#Projection"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasSnapshot">
    <rdfs:label>has snapshot</rdfs:label>
    <rdfs:comment>Associates an aggregate with its state snapshots</rdfs:comment>
    <rdfs:domain rdf:resource="#Aggregate"/>
    <rdfs:range rdf:resource="#Snapshot"/>
  </owl:ObjectProperty>

  <!-- Data Properties -->

  <owl:DatatypeProperty rdf:about="#commandType">
    <rdfs:label>command type</rdfs:label>
    <rdfs:comment>The type identifier of a command</rdfs:comment>
    <rdfs:domain rdf:resource="#Command"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#eventType">
    <rdfs:label>event type</rdfs:label>
    <rdfs:comment>The type identifier of an event</rdfs:comment>
    <rdfs:domain rdf:resource="#Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#aggregateId">
    <rdfs:label>aggregate id</rdfs:label>
    <rdfs:comment>The unique identifier of an aggregate instance</rdfs:comment>
    <rdfs:domain rdf:resource="#Aggregate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#aggregateVersion">
    <rdfs:label>aggregate version</rdfs:label>
    <rdfs:comment>The current version number of an aggregate, incremented with each event</rdfs:comment>
    <rdfs:domain rdf:resource="#Aggregate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#eventVersion">
    <rdfs:label>event version</rdfs:label>
    <rdfs:comment>The version number of an event within its stream</rdfs:comment>
    <rdfs:domain rdf:resource="#Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#eventTimestamp">
    <rdfs:label>event timestamp</rdfs:label>
    <rdfs:comment>The timestamp when an event was recorded</rdfs:comment>
    <rdfs:domain rdf:resource="#Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#eventData">
    <rdfs:label>event data</rdfs:label>
    <rdfs:comment>The payload data of an event</rdfs:comment>
    <rdfs:domain rdf:resource="#Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#commandData">
    <rdfs:label>command data</rdfs:label>
    <rdfs:comment>The payload data of a command</rdfs:comment>
    <rdfs:domain rdf:resource="#Command"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#aggregateState">
    <rdfs:label>aggregate state</rdfs:label>
    <rdfs:comment>The current state data of an aggregate</rdfs:comment>
    <rdfs:domain rdf:resource="#Aggregate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#streamId">
    <rdfs:label>stream id</rdfs:label>
    <rdfs:comment>The unique identifier of an event stream</rdfs:comment>
    <rdfs:domain rdf:resource="#EventStream"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#projectionName">
    <rdfs:label>projection name</rdfs:label>
    <rdfs:comment>The name identifier of a projection</rdfs:comment>
    <rdfs:domain rdf:resource="#Projection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#processManagerId">
    <rdfs:label>process manager id</rdfs:label>
    <rdfs:comment>The unique identifier of a process manager instance</rdfs:comment>
    <rdfs:domain rdf:resource="#ProcessManager"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#snapshotVersion">
    <rdfs:label>snapshot version</rdfs:label>
    <rdfs:comment>The aggregate version at which a snapshot was taken</rdfs:comment>
    <rdfs:domain rdf:resource="#Snapshot"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#snapshotData">
    <rdfs:label>snapshot data</rdfs:label>
    <rdfs:comment>The serialized state data of a snapshot</rdfs:comment>
    <rdfs:domain rdf:resource="#Snapshot"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#causationId">
    <rdfs:label>causation id</rdfs:label>
    <rdfs:comment>The identifier linking an event to the command that caused it</rdfs:comment>
    <rdfs:domain rdf:resource="#Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#correlationId">
    <rdfs:label>correlation id</rdfs:label>
    <rdfs:comment>The identifier linking related events and commands in a business process</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

</rdf:RDF>
