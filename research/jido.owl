<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:jido="http://accountex.org/ontologies/jido#"
         xml:base="http://accountex.org/ontologies/jido">

  <owl:Ontology rdf:about="http://accountex.org/ontologies/jido">
    <rdfs:label>Jido Framework Ontology</rdfs:label>
    <rdfs:comment>An ontology describing the Jido autonomous agent framework for Elixir, including agents, actions, workflows, sensors, skills, instructions, and their relationships for building distributed agent systems.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="http://accountex.org/ontologies/jido/1.0.0"/>
  </owl:Ontology>

  <!-- Core Classes -->
  
  <owl:Class rdf:about="#Agent">
    <rdfs:label>Agent</rdfs:label>
    <rdfs:comment>A stateful entity that can plan and execute Actions. Agents maintain state through schemas and can adapt their behavior. Built on OTP GenServer for fault tolerance.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Action">
    <rdfs:label>Action</rdfs:label>
    <rdfs:comment>A discrete, reusable unit of work with defined input schema, description, and standardized results. Actions are composable building blocks that agents can orchestrate into workflows.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Workflow">
    <rdfs:label>Workflow</rdfs:label>
    <rdfs:comment>A sequence of Actions that accomplish larger goals. Workflows chain Actions together, pass data between them, handle errors, and support conditional paths and async execution.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Sensor">
    <rdfs:label>Sensor</rdfs:label>
    <rdfs:comment>A real-time monitoring and data gathering component that runs as independent processes, emits standardized signals, supports metrics collection, and enables adaptive behavior.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Skill">
    <rdfs:label>Skill</rdfs:label>
    <rdfs:comment>A modular, reusable module that encapsulates specific agent capabilities. Skills provide composable building blocks for sharing functionality between agents.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Instruction">
    <rdfs:label>Instruction</rdfs:label>
    <rdfs:comment>A routing directive that maps signals to actions, providing structured guidance for agent behavior and workflow execution.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Context">
    <rdfs:label>Context</rdfs:label>
    <rdfs:comment>Environmental state and execution context information passed to actions and workflows, including tenant information, environment settings, and execution metadata.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Signal">
    <rdfs:label>Signal</rdfs:label>
    <rdfs:comment>A structured message based on CloudEvents specification that provides standardized communication between distributed agents, enabling information exchange and coordination.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Schema">
    <rdfs:label>Schema</rdfs:label>
    <rdfs:comment>A validation specification that defines the structure, types, and constraints for agent state, action parameters, and other data structures.</rdfs:comment>
  </owl:Class>

  <!-- Object Properties -->

  <owl:ObjectProperty rdf:about="#hasAction">
    <rdfs:label>has action</rdfs:label>
    <rdfs:comment>Associates an agent with an action it can execute</rdfs:comment>
    <rdfs:domain rdf:resource="#Agent"/>
    <rdfs:range rdf:resource="#Action"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#executesWorkflow">
    <rdfs:label>executes workflow</rdfs:label>
    <rdfs:comment>Associates an agent with a workflow it can execute</rdfs:comment>
    <rdfs:domain rdf:resource="#Agent"/>
    <rdfs:range rdf:resource="#Workflow"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasSkill">
    <rdfs:label>has skill</rdfs:label>
    <rdfs:comment>Associates an agent with a skill that provides capabilities</rdfs:comment>
    <rdfs:domain rdf:resource="#Agent"/>
    <rdfs:range rdf:resource="#Skill"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#containsAction">
    <rdfs:label>contains action</rdfs:label>
    <rdfs:comment>Associates a workflow with the actions it orchestrates</rdfs:comment>
    <rdfs:domain rdf:resource="#Workflow"/>
    <rdfs:range rdf:resource="#Action"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasSchema">
    <rdfs:label>has schema</rdfs:label>
    <rdfs:comment>Associates an entity with its validation schema</rdfs:comment>
    <rdfs:range rdf:resource="#Schema"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#emitsSignal">
    <rdfs:label>emits signal</rdfs:label>
    <rdfs:comment>Associates a sensor with signals it emits</rdfs:comment>
    <rdfs:domain rdf:resource="#Sensor"/>
    <rdfs:range rdf:resource="#Signal"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#receivesSignal">
    <rdfs:label>receives signal</rdfs:label>
    <rdfs:comment>Associates an agent with signals it can receive and process</rdfs:comment>
    <rdfs:domain rdf:resource="#Agent"/>
    <rdfs:range rdf:resource="#Signal"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#providesInstruction">
    <rdfs:label>provides instruction</rdfs:label>
    <rdfs:comment>Associates a skill with instructions it provides</rdfs:comment>
    <rdfs:domain rdf:resource="#Skill"/>
    <rdfs:range rdf:resource="#Instruction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasContext">
    <rdfs:label>has context</rdfs:label>
    <rdfs:comment>Associates an action or workflow execution with its context</rdfs:comment>
    <rdfs:range rdf:resource="#Context"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#monitors">
    <rdfs:label>monitors</rdfs:label>
    <rdfs:comment>Associates a sensor with what it monitors (agents, workflows, or system components)</rdfs:comment>
    <rdfs:domain rdf:resource="#Sensor"/>
  </owl:ObjectProperty>

  <!-- Data Properties -->

  <owl:DatatypeProperty rdf:about="#hasName">
    <rdfs:label>has name</rdfs:label>
    <rdfs:comment>The name identifier of an entity</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasDescription">
    <rdfs:label>has description</rdfs:label>
    <rdfs:comment>A human-readable description of an entity</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasState">
    <rdfs:label>has state</rdfs:label>
    <rdfs:comment>The current state data of an agent</rdfs:comment>
    <rdfs:domain rdf:resource="#Agent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasVersion">
    <rdfs:label>has version</rdfs:label>
    <rdfs:comment>The version identifier of a skill or other versioned entity</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#isRunning">
    <rdfs:label>is running</rdfs:label>
    <rdfs:comment>Indicates whether an agent or sensor is currently active</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasEmitInterval">
    <rdfs:label>has emit interval</rdfs:label>
    <rdfs:comment>The interval at which a sensor emits signals (in milliseconds)</rdfs:comment>
    <rdfs:domain rdf:resource="#Sensor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#signalType">
    <rdfs:label>signal type</rdfs:label>
    <rdfs:comment>The type classification of a signal based on CloudEvents specification</rdfs:comment>
    <rdfs:domain rdf:resource="#Signal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#signalSource">
    <rdfs:label>signal source</rdfs:label>
    <rdfs:comment>The source identifier of a signal</rdfs:comment>
    <rdfs:domain rdf:resource="#Signal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasParameters">
    <rdfs:label>has parameters</rdfs:label>
    <rdfs:comment>The parameters or payload data of an action or instruction</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#executionResult">
    <rdfs:label>execution result</rdfs:label>
    <rdfs:comment>The result data from executing an action or workflow</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

</rdf:RDF>
